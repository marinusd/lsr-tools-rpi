# ECU data hub web interface on port 8080 (spec.md section 5).
# Installed by deploy/install.sh as /etc/systemd/system/ecu-web.service
[Unit]
Description=ECU data hub web interface (port 8080)
Documentation=file:/opt/ecu_hub/spec.md
After=network.target ecu-collector.service
Wants=ecu-collector.service

[Service]
Type=simple
User=ecu-web
Group=ecu-hub
UMask=0002
WorkingDirectory=/opt/ecu_hub
# matplotlib needs a writable directory for its font cache; ecu-web has no home directory
CacheDirectory=ecu_web
Environment=PYTHONUNBUFFERED=1 MPLCONFIGDIR=/var/cache/ecu_web
ExecStart=/usr/bin/python3 /opt/ecu_hub/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
